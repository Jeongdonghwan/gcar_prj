# =============================================================================
# Great Car — Nginx site config
#   /etc/nginx/sites-available/greatcar
#
# 도메인:
#   greatcar.kr        (primary — 실제 사이트)
#   greatcar.co.kr     (301 redirect to greatcar.kr)
#   www.greatcar.kr    (301 redirect to greatcar.kr)
#   www.greatcar.co.kr (301 redirect to greatcar.kr)
#
# 이 파일 그대로 배치한 뒤 certbot 실행하면 SSL(443) 블록이 자동 삽입됩니다:
#   sudo certbot --nginx -d greatcar.kr -d www.greatcar.kr -d greatcar.co.kr -d www.greatcar.co.kr
# =============================================================================

# ---- HTTP → HTTPS 리다이렉트 (certbot이 자동으로 이 블록 갱신) --------------
server {
    listen 80;
    listen [::]:80;
    server_name greatcar.kr www.greatcar.kr greatcar.co.kr www.greatcar.co.kr;

    # Let's Encrypt 검증 통과용
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://greatcar.kr$request_uri;
    }
}

# ---- www / co.kr → primary (greatcar.kr) 301 -------------------------------
# (Certbot이 아래 블록들에 listen 443 ssl 자동 추가)
server {
    server_name www.greatcar.kr greatcar.co.kr www.greatcar.co.kr;
    return 301 https://greatcar.kr$request_uri;
}

# ---- Primary: greatcar.kr --------------------------------------------------
server {
    server_name greatcar.kr;

    # Certbot이 SSL 블록 자동 삽입
    # listen 443 ssl http2;
    # ssl_certificate     /etc/letsencrypt/live/greatcar.kr/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/greatcar.kr/privkey.pem;
    # include /etc/letsencrypt/options-ssl-nginx.conf;
    # ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # 업로드 최대 크기 (배너/차량 이미지)
    client_max_body_size 15M;

    # 정적 파일 (Nginx가 직접 서빙 — Gunicorn 부담 감소)
    location /static/ {
        alias /var/www/greatcar/app/static/;
        expires 7d;
        access_log off;
        add_header Cache-Control "public, immutable, max-age=604800";
    }

    # Gunicorn upstream
    location / {
        proxy_pass http://127.0.0.1:8002;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_connect_timeout 10s;

        # 대용량 응답 버퍼링
        proxy_buffering on;
        proxy_buffer_size 8k;
        proxy_buffers 8 8k;
    }

    # gzip
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;
    gzip_min_length 1024;

    # 로그
    access_log /var/log/nginx/greatcar-access.log;
    error_log  /var/log/nginx/greatcar-error.log;
}
