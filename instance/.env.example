# Copy this file to instance/.env and fill in real values. NEVER commit .env.

FLASK_APP=run.py
FLASK_ENV=development

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-hex-string

# MariaDB local
DB_USER=garage
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=garage

# Kakao OAuth (Sprint 3) — leave blank during Sprint 1-2
KAKAO_REST_API_KEY=
KAKAO_REDIRECT_URI=http://localhost:5000/auth/kakao/callback

# Kakao 1:1 channel URL (Sprint 4 — overridable via SiteSetting admin page)
KAKAO_CHANNEL_URL=https://pf.kakao.com/_xxxxx/chat
